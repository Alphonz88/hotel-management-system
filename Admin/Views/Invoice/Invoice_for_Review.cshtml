	$('#mah_tbl_select_all').on('click', function () {
		var table = $("#tblInvoice").DataTable();
		var rows = table.rows({ 'search': 'applied' }).nodes();

		// Check/uncheck all checkboxes in the table
		var isChecked = this.checked;
		$('input[name="invoicecheck"]', rows).prop('checked', isChecked);

		// Clear the arrays if no checkboxes are checked
		if (!isChecked) {

			$(".add-review-btn").hide();
		} else {
			// Show review button when items are checked
			$(".add-review-btn").show();
		}

		// Process checked checkboxes and add values to arrays
		$('input[name="invoicecheck"]:checked', rows).each(function () {
			var checkboxId = $(this).attr('id');
			var $tr = $(this).closest('tr');


			var detailId = $tr.find('td:eq(0) > input').attr('id');

			// Check if the detailId is not in the arr_selected_for_verification array
			if (!arr_selected_for_verification.includes(detailId)) {




				var id = $tr.find('td:eq(0) > input').attr('id');


				arr_selected_for_verification.push(id);
				 
			}

		});



	});
