													}				 
													
												}
					 
												return '<div class="dropdown actions__item">' +
												'<i data-toggle="dropdown" class="fa fa-ellipsis-h"></i>' +
												'<div class="dropdown-menu dropdown-menu-right">' + appendMessage +
		 

												'</div>' +
												'</div>'
											}
									}

						}

	 ],
	data:Invoicedata
	})
		  
