															allowOutsideClick: false,
															allowEscapeKey: false,
															allowEnterKey: false
															}) 
															$("#reviewcomments").focus()
															return;
														}else{

	setTimeout(() => {
	var  Invoiceid = getUrlVars()["Invoiceid"];
 var postData = {
						Invoiceid: Invoiceid,
						verifiedstatus: this.id,
						reviewcomments: $("#reviewcomments").val()
					};

		postData[''] = $('#').val();


$.ajax({
    url: '@Url.Action("verify_Invoice")',
    method: 'POST',
    contentType: 'application/json',
    dataType: 'json',
    data: JSON.stringify(postData),
    success: function(data) {
        if (data == "201.1") {
            swal({
                title: 'Success',
                text: "Your review has been updated!",
                type: 'success',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-primary',
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false
            }).then(() => {
                  if (document.referrer && document.referrer !== window.location.href) {
				window.location = document.referrer;
			} else if (window.history.length > 1) {
				// Go back in history if possible
				window.history.back();
			} else {
				window.location.reload();
			}
            });
            
           fill_Invoice_view_data()
        } else {
            // The server returned an error message (string)
            swal({
                title: 'Error',
                text: data || "An error occurred",
                type: 'error',
                buttonsStyling: false,
                confirmButtonClass: 'btn btn-danger'
            });
        }
    },
    error: function(xhr, status, error) {
        // AJAX error (network, server error, etc.)
        swal({
            title: 'Error',
            text: "An error occurred while processing your request. Please try again.",
            type: 'error',
            buttonsStyling: false,
            confirmButtonClass: 'btn btn-danger'
        });
    }
});
	},1);
}


})

$.ajax({
	url: '@Url.Action("get_lookups_by_entity","lookups")',
	dataType: 'json',
	data:{id: 'Invoice' },
	success: function(data) {

	$.each(data, function(index, optionDataInner) {
	if(optionDataInner.fieldname=="verifiedstatus"){
			var ddltarget_verifiedstatus = "#verifiedstatus_buttons"

			$(ddltarget_verifiedstatus).empty()

			if(optionDataInner.fieldname=="verifiedstatus"){
	 
					var options_verifiedstatus = optionDataInner.fielddesc.split(',');
					options_verifiedstatus.forEach(function(option_verifiedstatus){
						if(option_verifiedstatus !='Ready For Review' && option_verifiedstatus !='Revised'){
 var displayText = option_verifiedstatus;
						if (option_verifiedstatus === "Approved") {
							displayText = "Approve";
						}
						else if
						(option_verifiedstatus === "Rejected") {
							displayText = "Reject";
						}
						$(ddltarget_verifiedstatus).append('<button style="display:none" class="btn btn-primary   auto_checker_action" id='+option_verifiedstatus+'>'+displayText+'</button>')
	
						}		
					})  
					fill_Invoice_view_data()
				}


	}
	})


}

})

					


 




