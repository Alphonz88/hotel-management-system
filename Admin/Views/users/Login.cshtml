														confirmButtonClass: 'btn btn-primary',
														allowOutsideClick: false,
														allowEscapeKey: false,
														allowEnterKey: false
													})
												}
											})
				})
				var str = "";
				</script>
				<script>
					$(document).ready(function () {
						localStorage.removeItem("activeMenuClass");
