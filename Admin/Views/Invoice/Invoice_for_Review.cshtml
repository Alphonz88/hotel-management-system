				onComplete: function () {
					// Do additional setup if needed after the content is displayed
				}
			});

		// Attach event listeners to your buttons
		document.getElementById('Rework_').addEventListener('click', handleButtonClick);
		document.getElementById('Approved_').addEventListener('click', handleButtonClick);
