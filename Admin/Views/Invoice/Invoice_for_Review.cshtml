		content.innerHTML = '<label>Review Comments</label><br><textarea id="bulk_reviewcomments" class="form-control" placeholder="Enter Review Comments"></textarea><br><span id="verified_reject_message" style="color:red;display:none;" >Please enter Review Comments</span><div class="btn-group pull-right" id="verifiedstatus_buttons"><button class="btn btn-primary" id="Rework_" style="display: block;">Rework</button><button class="btn btn-primary" id="Approved_" style="display: block;">Approve</button><button class="btn btn-primary" id="Rejected_" style="display: block;">Reject</button></div>';
 
