<script>
	
   
	var fileInputidproof = document.getElementById('idproof');
	
	var filesTabidproof = $('#idprooffilesTab');
	var uploadernameidproof = document.querySelector(".idprooffilebtn");
	var idproofselectedFiles = [];
	var idproofexistingFiles = idproofuploaded_attachments;
	renderExistingFileListOfidproof();
	updateFileCountofidproof();
	var lastActiveDropZone = null;

	fileInputidproof.addEventListener('change', function (e) {
		var files = e.target.files;

		// Append the newly selected files to the existing idproofselectedFiles array
		idproofselectedFiles.push(...files);


		// Render the file list
		renderFileListofidproof();

		 

		// Update the file count
		updateFileCountofidproof();
	});

	// Drag & Drop and Paste functionality
	var dropZone = document.getElementById('dropZoneidproof');

	// Click to paste functionality
	dropZone.addEventListener('click', function () {
		lastActiveDropZone = 'idproof';
		// Try to read from clipboard
		if (navigator.clipboard && navigator.clipboard.read) {
			navigator.clipboard.read().then(items => {
				items.forEach(item => {
					if (item.types.includes('image/png') || item.types.includes('image/jpeg')) {
						item.getType(item.types[0]).then(blob => {
							var file = new File([blob], "pasted_image.png", { type: blob.type });
							idproofselectedFiles.push(file);
							renderFileListofidproof();
							updateFileCountofidproof();
							clearClipboard();  
						});
					}
				});
			}).catch(err => {
				console.error('Failed to read clipboard contents: ', err);
			});
		}
	});

	// Drag over event
	dropZone.addEventListener('dragover', function (event) {
		event.preventDefault();
		dropZone.classList.add('dragover');
		lastActiveDropZone = 'idproof';
	});

	// Drag leave event
	dropZone.addEventListener('dragleave', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
	});

	// Drop event
	dropZone.addEventListener('drop', function (event) {
		event.preventDefault();
		dropZone.classList.remove('dragover');
		var files = event.dataTransfer.files;
		idproofselectedFiles.push(...files);
		renderFileListofidproof();
		updateFileCountofidproof();
	});

	// Global paste event
	document.addEventListener('paste', function (event) {
		if (lastActiveDropZone === 'idproof') {
			var items = event.clipboardData.items;
			for (var i = 0; i < items.length; i++) {
				if (items[i].kind === 'file') {
					var file = items[i].getAsFile();
					idproofselectedFiles.push(file);
					renderFileListofidproof();
					updateFileCountofidproof();
					clearClipboard(); 
				} else if (items[i].kind === 'string') {
					items[i].getAsString(function (text) {
						// Check if it's an image URL
						if (text.match(/\.(jpeg|jpg|gif|png)$/) != null) {
							var img = new Image();
							img.onload = function () {
								var canvas = document.createElement('canvas');
								canvas.width = img.width;
								canvas.height = img.height;
								var ctx = canvas.getContext('2d');
								ctx.drawImage(img, 0, 0);
								canvas.toBlob(function (blob) {
									var file = new File([blob], "pasted_image.png", { type: blob.type });
									idproofselectedFiles.push(file);
									renderFileListofidproof();
									updateFileCountofidproof();
									clearClipboard();  // Clear the clipboard after processing the image
								}, 'image/png');
							};
							img.src = text;
						}
					});
				}
			}
		}
		});
	 
	function renderExistingFileListOfidproof() {
		// Remove all <tr> elements with the class name existingFile
		filesTabidproof.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < idproofexistingFiles.length; i++) {
			var file = idproofexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
			  var filedisplayname = fileName.substring(fileName.lastIndexOf('/') + 1);
																				 
			var row = $('<tr>').attr('id', 'fileidproof' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + fileName + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + filedisplayname + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingidproof' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabidproof.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventidproof(i);
		}
	}

	function renderFileListofidproof() {
		// Remove all <tr> elements with the class name newFile
		filesTabidproof.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < idproofselectedFiles.length; i++) {
			var file = idproofselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'fileidproof' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '" alt="icon"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delidproof' + i + '"><img src="' + vBaseurl + '/images/delete.png" alt="icon"></span>'));

			filesTabidproof.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventidproof(i);
		}
	}

	function bindDeleteEventidproof(index) {
		$(".delidproof" + index).click(function () {
			// Remove the file from the selected files array
			idproofselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofidproof();

			// Update the file count
			updateFileCountofidproof();
		});
	}
	function bindDeleteExistingEventidproof(index) {
		$(".delexistingidproof" + index).click(function () {
			// Remove the file from the selected files array
			idproofexistingFiles.splice(index, 1);
			
			$("#idproof_existing").val(idproofexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfidproof();

			// Update the file count
			updateFileCountofidproof();
		});
	}
	function updateFileCountofidproof() {
		// Display the file count
		uploadernameidproof.innerHTML = idproofselectedFiles.length + idproofexistingFiles.length + ' files selected';
		 
	}
	function clearClipboard() {
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText('').then(function () {
				console.log('Clipboard cleared');
			}, function (err) {
				console.error('Could not clear clipboard: ', err);
			});
		}
	}


</script>
